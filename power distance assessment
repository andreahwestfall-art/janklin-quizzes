Reach out: andrea@janklin.ca";
  document.getElementById("rcon").innerHTML='<div class="rhead"><div class="ey">Your results</div><h2>Your power distance orientation</h2><p>This is a starting point for reflection, not a fixed label. It shows how you tend to see the world — and invites you to consider how others may see it differently.</p></div><div class="rcard"><span class="rtag '+tc[lv]+'">'+lb[lv]+'</span><div class="rorient">'+pct+'% — '+lb[lv]+'</div><div class="btrack"><div class="bfill '+bc[lv]+'" style="width:'+pct+'%"></div></div><div class="blabels"><span>Low (egalitarian)</span><span>High (hierarchical)</span></div><div class="rdesc">'+ds[lv]+'</div><div class="chead">Engaging across the difference</div><div class="cbody">'+ct[lv]+'</div></div><div class="scard"><h3>Save your results</h3><p>Copy the text below and paste it into an email, note, or document. Or print a copy for yourself.</p><div class="rtbox" id="rtx">'+pt+'</div><div class="sbtns2"><button class="btn-cp" id="bcp" onclick="doCopy()">Copy to clipboard</button><button class="btn-pr" onclick="doPrint()">Print / Save as PDF</button></div><div class="cnote" id="cnote">Select all the text above and copy, or use the button.</div></div><button class="btn-retake" onclick="retake()">Retake the quiz</button><div class="ft"><div class="ft-brand">Janklin Consulting</div><div class="ft-sub">Created by Andrea McCoy &middot; Cultural Privilege &amp; Workplace Inclusion</div><div class="ft-con"><a href="mailto:andrea@janklin.ca">andrea@janklin.ca</a> &middot; <a href="https://janklin.ca" target="_blank">janklin.ca</a></div><div class="ft-cta">Ready to bring this work into your team or organization?<br><a href="mailto:andrea@janklin.ca">Reach out to Andrea</a> to explore how Janklin Consulting can support your workplace culture journey.</div></div>';
  window.scrollTo({top:0});
}
function doCopy(){
  var txt=document.getElementById("rtx").innerText;
  var btn=document.getElementById("bcp");
  var note=document.getElementById("cnote");
  if(navigator.clipboard&&navigator.clipboard.writeText){
    navigator.clipboard.writeText(txt).then(function(){
      btn.textContent="Copied!";btn.classList.add("done");
      note.textContent="Paste into an email, Google Doc, or anywhere you like.";
      setTimeout(function(){btn.textContent="Copy to clipboard";btn.classList.remove("done");},3000);
    }).catch(function(){fb(txt,note);});
  }else{fb(txt,note);}
}
function fb(txt,note){
  var ta=document.createElement("textarea");ta.value=txt;ta.style.position="fixed";ta.style.opacity="0";
  document.body.appendChild(ta);ta.focus();ta.select();
  try{document.execCommand("copy");note.textContent="Copied!";}
  catch(e){note.textContent="Select all the text in the box and copy manually (Ctrl+C or Cmd+C).";}
  document.body.removeChild(ta);
}
