<body>
<div class="wrap" id="app">

<div class="hd">
  <div class="tag">Cultural Dimensions &middot; Quiz 1 of 2</div>
  <h1>Power Distance</h1>
  <p>A self-reflection on how you relate to authority, hierarchy, and the distribution of power in your workplace and community.</p>
</div>

<div id="s-intro">
  <div class="icard">
    <h3>How this works</h3>
    <p>You will respond to 8 statements about authority and hierarchy. Rate each from 1 (strongly disagree) to 5 (strongly agree). There are no right or wrong answers &mdash; only a clearer view of how you see the world.</p>
  </div>
  <div class="icard">
    <h3>What is power distance?</h3>
    <p>From Geert Hofstede&rsquo;s cultural dimensions research, power distance describes how people relate to authority and inequality. Those with high power distance accept hierarchical order; those with low power distance question it and prefer egalitarian structures.</p>
  </div>
  <button class="btn-start" onclick="startQuiz()">Begin the quiz &rarr;</button>
  <div class="ft" style="margin-top:1.5rem">
    <div class="ft-brand">Janklin Consulting</div>
    <div class="ft-sub">Created by Andrea McCoy</div>
    <div class="ft-con"><a href="/cdn-cgi/l/email-protection#3d5c53594f585c7d575c5356515453135e5c"><span class="__cf_email__" data-cfemail="7819161c0a1d193812191613141116561b19">[email&#160;protected]</span></a> &middot; <a href="https://janklin.ca" target="_blank">janklin.ca</a></div>
  </div>
</div>

<div id="s-quiz" style="display:none">
  <div class="prog-wrap">
    <div class="prog-meta"><span>Power Distance</span><span id="qctr"></span></div>
    <div class="prog-track"><div class="prog-fill" id="prog" style="width:0%"></div></div>
  </div>
  <div id="qcon"></div>
  <div class="nav">
    <button class="btn-back" id="bbk" onclick="goBack()" style="display:none">&larr; Back</button>
    <button class="btn-next" id="bnx" onclick="goNext()">Next &rarr;</button>
  </div>
  <div class="warn" id="warn">Please respond to all statements before continuing.</div>
</div>

<div id="s-res" style="display:none"><div id="rcon"></div></div>

</div>
<script data-cfasync="false" src="/cdn-cgi/scripts/5c5dd728/cloudflare-static/email-decode.min.js"></script><script>
var qs=[
  {id:"pd1",text:"I believe it is important to respect and follow decisions made by those in authority, even when I disagree."},
  {id:"pd2",text:"In a workplace, a clear hierarchy helps things run smoothly and reduces confusion."},
  {id:"pd3",text:"I feel comfortable expressing disagreement directly to a manager or supervisor.",rev:true},
  {id:"pd4",text:"People in positions of power deserve special privileges and recognition."},
  {id:"pd5",text:"I prefer working in environments where decisions come from the top, rather than through group discussion."},
  {id:"pd6",text:"I believe leaders and employees are fundamentally different types of people."},
  {id:"pd7",text:"It is disrespectful to question the decisions of someone more senior than you."},
  {id:"pd8",text:"Status symbols &mdash; titles, office size, dress &mdash; are an important part of professional life."}
];
var PS=4,ans={},pg=0,tot=Math.ceil(qs.length/PS);
function sc(v,q){return q.rev?6-v:v;}
function startQuiz(){document.getElementById("s-intro").style.display="none";document.getElementById("s-quiz").style.display="block";render();}
function render(){
  var s=pg*PS,e=Math.min(s+PS,qs.length),sl=qs.slice(s,e);
  document.getElementById("prog").style.width=Math.round(pg/tot*100)+"%";
  document.getElementById("qctr").textContent=(s+1)+"&ndash;"+e+" of "+qs.length;
  document.getElementById("bbk").style.display=pg>0?"block":"none";
  document.getElementById("bnx").textContent=pg===tot-1?"See my results →":"Next →";
  document.getElementById("warn").style.display="none";
  var h="";
  sl.forEach(function(q){
    var a=ans[q.id]||0;
    h+='<div class="qcard'+(a?" ans":"")+'"><div class="qtxt">'+q.text+'</div><div class="sbwrap"><div class="sbtns">';
    for(var v=1;v<=5;v++) h+='<button class="sb'+(a===v?" sel":"")+'" onclick="pick(''+q.id+'','+v+')">'+v+'</button>';
    h+='</div><div class="sendrow"><span>Strongly disagree</span><span>Strongly agree</span></div></div></div>';
  });
  document.getElementById("qcon").innerHTML=h;
}
function pick(id,v){ans[id]=v;render();}
function goNext(){
  var s=pg*PS,e=Math.min(s+PS,qs.length),sl=qs.slice(s,e);
  if(sl.some(function(q){return!ans[q.id];})){document.getElementById("warn").style.display="block";return;}
  if(pg<tot-1){pg++;render();window.scrollTo({top:0});}else showRes();
}
function goBack(){if(pg>0){pg--;render();window.scrollTo({top:0});}}
function showRes(){
  document.getElementById("s-quiz").style.display="none";
  document.getElementById("s-res").style.display="block";
  var raw=qs.reduce(function(s,q){return s+sc(ans[q.id],q);},0);
  var pct=Math.round(raw/(qs.length*5)*100);
  var lv=pct>=65?"high":pct>=40?"moderate":"low";
  var lb={low:"Low power distance",moderate:"Moderate power distance",high:"High power distance"};
  var tc={low:"tl",moderate:"tm",high:"th"};
  var bc={low:"bl",moderate:"bm",high:"bh"};
  var ds={
    low:"You generally prefer flat, egalitarian environments where everyone's voice carries equal weight regardless of title or tenure. You are comfortable challenging authority, questioning decisions, and expect leaders to earn respect rather than assume it. Transparency and accessibility in leadership feel natural and right to you.",
    moderate:"You have a nuanced relationship with hierarchy. You can work within formal structures and respect the authority of leaders, but you also believe in the value of open dialogue across levels. Context matters to you when deciding how much deference is appropriate — and you tend to adapt.",
    high:"You tend to accept and respect hierarchical structures in your workplace and community. Titles, seniority, and formal authority feel meaningful and legitimate to you. You may value clear chains of command, expect leaders to take decisive charge, and find comfort in knowing where you stand in a structure."
  };
  var ct={
    low:"When working with someone high in power distance, know that addressing a concern to a peer rather than escalating it through proper channels may feel unsafe or disloyal to them. Formal acknowledgment of their role and seniority can make communication feel more respectful and secure. Avoid interpreting deference as passivity — it may be a sign of deep respect.",
    moderate:"Your flexibility is a strength. When working with high power distance colleagues, lean into structure and formality; when working with low power distance colleagues, invite debate and direct challenge. Your ability to read the room and shift your approach is valuable across cultural contexts.",
    high:"When working with someone low in power distance, know that they may speak directly to senior leaders and question decisions openly — this is not disrespect, but how they build trust. Invite their input in meetings, and don't interpret directness as insubordination. They may also expect leaders to be accessible and to explain their reasoning."
  };
  var pt="POWER DISTANCE SELF-REFLECTION RESULTS
=======================================
